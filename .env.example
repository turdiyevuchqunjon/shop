# ============================================
# TELEGRAM BOT sozlamalari
# ============================================
# 1. @BotFather ga boring va yangi bot yarating, tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Botingizni guruh/kanalga qo'shing va chat_id ni oling
#    Chat_id ni olish uchun: @userinfobot yoki @getidsbot
TELEGRAM_CHAT_ID=-1001234567890

# 3. Lid bosgandan keyin foydalanuvchi yo'naltiriladigan Telegram havolasi
NEXT_PUBLIC_TELEGRAM_REDIRECT_URL=https://t.me/your_channel

# ============================================
# META CONVERSIONS API (CAPI) sozlamalari
# ============================================
# Facebook Business Manager → Events Manager → Pixel → Settings → Conversions API
META_PIXEL_ID=1234567890123456
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Test event code (test paytida ishlatiladi, productionda bo'sh qoldiring)
# META_TEST_EVENT_CODE=TEST12345

# Public pixel ID (frontend Pixel uchun ham kerak)
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
